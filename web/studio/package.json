{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@repo/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prettier": "@repo/prettier-config/next",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3006",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3006",
    "typecheck": "next typegen && tsc --noEmit",
